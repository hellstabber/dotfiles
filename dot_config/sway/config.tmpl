# ============================================================
# Variables
# ============================================================

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $term ghostty
set $menu fuzzel


# ============================================================
# Theme
# ============================================================

set {
    $black    #0b090d
    $panel    #17111d
    $line     #2a2030

    $purple   #8f6aa8
    $purpleLt #b89ad0

    $amber    #c98b5b
    $red      #8f2d3c

    $muted    #7f7187
    $text     #e6dfe8
}

#                         border    bgrnd     text       indic       child
client.focused            $panel    $panel    $purple    $purpleLt   $panel
client.unfocused          $black    $black    $muted     $panel      $panel
client.focused_inactive   $black    $black    $muted     $black      $black
client.focused_tab_title  $panel    $panel    $muted
client.urgent             $red      $red      $text      $amber      $red
client.placeholder        $black    $black    $text      $text       $black


font pango:IBM Plex Mono 10

default_border pixel 2
default_floating_border pixel 2

titlebar_border_thickness 2
titlebar_padding 6 4

gaps inner 0
gaps outer 0

hide_edge_borders none
show_marks yes

focus_follows_mouse no
focus_on_window_activation smart


# ============================================================
# Inputs
# ============================================================

input "type:keyboard" {
    xkb_layout tr
    repeat_delay 250
    repeat_rate 35
}

input "type:pointer" {
    pointer_accel 0
}


# ============================================================
# Outputs
# ============================================================

output * bg ~/.config/backgrounds/1.jpg fill

{{ if eq .chezmoi.hostname "molly" }}
output DP-1 {
    mode 1920x1080@60Hz
    position 0 0
    scale 1
}

output HDMI-A-1 {
    mode 1920x1080@60Hz
    position 1920 0
    scale 1
}
{{ end }}


# ============================================================
# Applications
# ============================================================

# Sway keybinding help
bindsym $mod+Shift+slash exec ~/.local/bin/sway-help

# Terminal
bindsym $mod+Return exec $term

# Launcher
bindsym $mod+Space exec $menu

# Last notification
bindsym $mod+grave exec makoctl restore

# Kill window
bindsym $mod+Escape kill

# Lock
bindsym $mod+Ctrl+q exec swaylock -f

# Reload
bindsym $mod+Shift+c reload

# Exit
bindsym $mod+Shift+e exec swaynag \
    -t warning \
    -m 'EXIT SWAY SESSION' \
    -b 'YES' 'swaymsg exit'


# ============================================================
# Media
# ============================================================

# Actual media/Fn keys
bindsym XF86AudioMute exec \
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bindsym XF86AudioLowerVolume exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

bindsym XF86AudioRaiseVolume exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next

bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set +5%

bindsym XF86KbdBrightnessDown exec \
    brightnessctl --device='smc::kbd_backlight' set 10%-

bindsym XF86KbdBrightnessUp exec \
    brightnessctl --device='smc::kbd_backlight' set +10%


# mrusme-style Mod + function keys
bindsym $mod+F1 exec \
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

bindsym $mod+F2 exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

bindsym $mod+F3 exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

bindsym $mod+F5 exec playerctl previous
bindsym $mod+F6 exec playerctl play-pause
bindsym $mod+F7 exec playerctl next

bindsym $mod+F8 exec brightnessctl set 5%-
bindsym $mod+F9 exec brightnessctl set +5%


# ============================================================
# Screenshots
# ============================================================

# Whole screen
bindsym Print exec sh -c \
    'mkdir -p "$HOME/Pictures/Screenshots"; \
     grim "$HOME/Pictures/Screenshots/$(date +screenshot-%Y-%m-%d-%H%M%S).png"'

# Region -> file
bindsym Shift+Print exec sh -c \
    'mkdir -p "$HOME/Pictures/Screenshots"; \
     geometry="$(slurp)" && \
     grim -g "$geometry" \
     "$HOME/Pictures/Screenshots/$(date +screenshot-%Y-%m-%d-%H%M%S).png"'

# Region -> clipboard
bindsym $mod+Print exec sh -c \
    'geometry="$(slurp)" && grim -g "$geometry" - | wl-copy'


# ============================================================
# Focus
# ============================================================

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Ctrl+p focus parent


# ============================================================
# Move windows
# ============================================================

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


# ============================================================
# Workspaces
# ============================================================

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next


# ============================================================
# Workspace outputs
# ============================================================

{{ if eq .chezmoi.hostname "molly" }}
workspace 1 output DP-1
workspace 2 output HDMI-A-1
workspace 3 output DP-1
workspace 4 output HDMI-A-1
workspace 5 output DP-1
workspace 6 output HDMI-A-1
workspace 7 output DP-1
workspace 8 output HDMI-A-1
workspace 9 output DP-1
workspace 10 output HDMI-A-1
{{ end }}


# ============================================================
# Layout
# ============================================================

bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+Shift+s layout toggle split

bindsym $mod+equal splith
bindsym $mod+minus splitv

bindsym $mod+Shift+z floating toggle
bindsym $mod+Tab focus mode_toggle

bindsym $mod+z fullscreen toggle

floating_modifier $mod normal


# ============================================================
# Scratchpad
# ============================================================

bindsym $mod+Ctrl+grave scratchpad show
bindsym $mod+Ctrl+Shift+grave move scratchpad


# ============================================================
# Resize
# ============================================================

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Escape mode "default"
    bindsym Return mode "default"
}

bindsym $mod+r mode "resize"


# ============================================================
# Window rules
# ============================================================

for_window [app_id="pavucontrol"] floating enable
for_window [app_id="org.gnupg.pinentry-qt"] floating enable
for_window [app_id="keepassxc"] floating enable

for_window [title="^Open File$"] floating enable
for_window [title="^Open Files$"] floating enable

for_window [title="Firefox - Sharing Indicator"] floating enable
for_window [title="^Extension: .*" app_id="firefox"] floating enable

for_window [shell="xwayland"] \
    title_format "<span>[X11] %title</span>"


# ============================================================
# Waybar
# ============================================================

bar {
    id mainbar
    output *
    swaybar_command waybar
}


# ============================================================
# Services
# ============================================================

# Notifications
exec --no-startup-id mako

# GNOME Secret Service
exec --no-startup-id \
    gnome-keyring-daemon --start --components=secrets


# Color temperature
exec --no-startup-id \
    wlsunset -S 06:30 -s 19:30 -d 1800

# Idle manager
exec --no-startup-id swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'


# ============================================================
# System
# ============================================================

include /etc/sway/config.d/*
